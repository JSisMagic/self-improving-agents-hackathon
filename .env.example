# Band is optional; false preserves the dependency-free direct-call path.
BAND_ENABLED=false
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket
BAND_TIMEOUT_SECONDS=30
BAND_STARTUP_TIMEOUT_SECONDS=20

# Create four External Agents in Band. Never commit the real values.
BAND_COORDINATOR_AGENT_ID=<coordinator-agent-uuid>
BAND_COORDINATOR_API_KEY=<coordinator-agent-api-key>
BAND_SCOUT_AGENT_ID=<scout-agent-uuid>
BAND_SCOUT_API_KEY=<scout-agent-api-key>
BAND_ANALYST_AGENT_ID=<analyst-agent-uuid>
BAND_ANALYST_API_KEY=<analyst-agent-api-key>
BAND_COACH_AGENT_ID=<coach-agent-uuid>
BAND_COACH_API_KEY=<coach-agent-api-key>

# Actian is opt-in. The default false value preserves the local JSON path.
ACTIAN_VECTORAI_ENABLED=false
ACTIAN_VECTORAI_URL=localhost:6574
ACTIAN_VECTORAI_COLLECTION=event_copilot_episodes_v1
# Optional for an authenticated remote deployment. Never commit a real token.
ACTIAN_VECTORAI_ACCESS_TOKEN=
ACTIAN_VECTORAI_TIMEOUT=5
ACTIAN_VECTORAI_MAX_RETRIES=1
ACTIAN_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ACTIAN_EMBEDDING_DIMENSION=384
# Optional minimum cosine relevance. Empty means no threshold.
ACTIAN_SCORE_THRESHOLD=
