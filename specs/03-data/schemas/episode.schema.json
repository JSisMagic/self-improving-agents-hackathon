{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-copilot.local/schemas/episode.schema.json",
  "title": "EventEpisode",
  "type": "object",
  "required": [
    "schema_version",
    "episode_id",
    "user_id",
    "event_id",
    "recommendation",
    "feedback",
    "actual_scores",
    "actual_event_success",
    "scoring_version",
    "observed_at",
    "storage_mode"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "episode_id": { "type": "string", "minLength": 1 },
    "user_id": { "type": "string", "minLength": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "recommendation": {
      "$ref": "recommendation.schema.json"
    },
    "feedback": {
      "$ref": "feedback.schema.json"
    },
    "actual_scores": {
      "type": "object",
      "required": ["networking", "knowledge", "opportunity", "personal_fit"],
      "properties": {
        "networking": { "$ref": "#/$defs/score" },
        "knowledge": { "$ref": "#/$defs/score" },
        "opportunity": { "$ref": "#/$defs/score" },
        "personal_fit": { "$ref": "#/$defs/score" }
      },
      "additionalProperties": false
    },
    "actual_event_success": { "$ref": "#/$defs/score" },
    "scoring_version": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "storage_mode": { "enum": ["live", "fixture", "local_fallback"] },
    "derived_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scoring_version", "derived_at", "actual_event_success"],
        "properties": {
          "scoring_version": { "type": "string", "minLength": 1 },
          "derived_at": { "type": "string", "format": "date-time" },
          "actual_event_success": { "$ref": "#/$defs/score" }
        }
      }
    }
  },
  "$defs": {
    "score": { "type": "number", "minimum": 0, "maximum": 100 }
  }
}
