{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-copilot.local/schemas/profile.schema.json",
  "title": "UserProfile",
  "type": "object",
  "required": [
    "schema_version",
    "user_id",
    "role",
    "goal_priorities",
    "desired_outcomes",
    "preferences",
    "constraints"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "user_id": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "goal_priorities": {
      "type": "object",
      "required": ["networking", "knowledge", "opportunity"],
      "properties": {
        "networking": { "type": "number", "minimum": 0, "maximum": 1 },
        "knowledge": { "type": "number", "minimum": 0, "maximum": 1 },
        "opportunity": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "desired_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "preferences": { "type": "object" },
    "constraints": { "type": "object" }
  }
}
